metadata/_custom_type_script = "uid://qyrh2jt5lx0e"

[sub_resource type="Resource" id="Resource_ko6ui"]
script = ExtResource("21_snavj")
text = "总之去三层配电室看看能不能恢复电力吧。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

