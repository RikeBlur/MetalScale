[sub_resource type="Resource" id="Resource_t31br"]
script = ExtResource("21_snavj")
text = "欸...真是稀奇，我还以为没有活人了。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_cb74a"]
script = ExtResource("21_snavj")
speaker_entity = "Oni"
text = "同学，这里现在到底......"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_7028d"]
script = ExtResource("21_snavj")
text = "处境和你差不多，完全没头绪啊。快点从这溜走会比较好。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_aosta"]
script = ExtResource("21_snavj")
text = "啊，不过建议的话， 先别去一层比较好。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_uwn8i"]
script = ExtResource("21_snavj")
text = "而且一层大门的电子锁估计打不开。总之还是先去三层配电室看看吧。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_c562g"]
script = ExtResource("21_cb74a")
speaker_entity = "Oni"
text = "(你看到了她衣服上的血渍)"
choice_text = Array[String](["同学你衣服上的是 ...", "(保持沉默)"])
choice_next_index = Array[int]([1, 2])
metadata/_custom_type_script = "uid://bns5otigdg8vu"

[sub_resource type="Resource" id="Resource_qr03t"]
script = ExtResource("21_snavj")
text = "啊啊...这个是刚刚逃跑时摔伤的，嗯自己的血。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_dmmh3"]
script = ExtResource("21_snavj")
text = "不知道你遇上了没有，但建筑里有些不安稳的东西。请多加小心。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_7bfiw"]
script = ExtResource("21_snavj")
text = "不知道你遇上了没有，但建筑里有些不安稳的东西。请多加小心。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_jloiq"]
script = ExtResource("21_snavj")
text = "这个可能对你有些用，拿上吧。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_pnopn"]
script = ExtResource("22_2ns1t")
