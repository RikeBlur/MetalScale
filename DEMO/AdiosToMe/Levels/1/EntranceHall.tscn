[sub_resource type="Resource" id="Resource_o7ogc"]
script = ExtResource("17_i0njy")
text = "嗯，一件完了。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_04m7r"]
script = ExtResource("17_i0njy")
text = "因为这个玩意儿跑得太块，找不到机会处理，拖到现在。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_1u768"]
script = ExtResource("17_i0njy")
speaker_entity = "Oni"
text = "其他怪物的尸体，也是你 ..."
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_agmmm"]
script = ExtResource("17_i0njy")
text = "啊啊，不过对我来说也挺勉强的。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_w30qo"]
script = ExtResource("17_i0njy")
text = "有什么想问的等出去了再说吧。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

[sub_resource type="Resource" id="Resource_ns1sq"]
script = ExtResource("17_i0njy")
text = "走吧。虽然都这样了，也不能指望外面有多安全啊。"
metadata/_custom_type_script = "uid://4p4vcldhkkvo"

